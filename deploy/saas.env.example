# Variáveis da edição SaaS. Copie para deploy/saas.env e preencha.
# Nada aqui tem valor padrão aceitável em produção: os três segredos são
# conferidos no boot e o processo se recusa a subir com um fraco.

# --- Postgres do compose (ignorado quando DATABASE_URL aponta para fora) ---
POSTGRES_USER=skygp
POSTGRES_PASSWORD=
POSTGRES_DB=skygp

# --- Nomes -----------------------------------------------------------------
# O painel de cada provedor vive em <slug>.TENANT_BASE_DOMAIN; o portal do
# assinante em <slug>.PORTAL_BASE_DOMAIN. O próprio TENANT_BASE_DOMAIN (e o
# www dele) é o endereço da PLATAFORMA: o cadastro de um ISP novo e o console
# vivem ali, e nada de provedor nenhum. CORS_ORIGINS abaixo é a origem desse
# console; os hosts de provedor entram pelo mesmo-host de `isAllowedOrigin`.
# Onde não há certificado curinga (DNS sem API, como o do Registro.br), cada
# provedor precisa do seu: `sudo ./deploy/novo-provedor.sh <slug>` lê a base
# daqui, emite e monta o bloco do nginx. Ver docs/saas-operations.md §1.
# Ligar só o do painel é legítimo: sem PORTAL_BASE_DOMAIN a porta 5891 apenas
# deixa de ter endereço, e o painel não é afetado. Um deploy que não usa o portal
# do assinante deixa a linha em branco em vez de inventar um nome para ela.
TENANT_BASE_DOMAIN=painel.exemplo.com
PORTAL_BASE_DOMAIN=portal.exemplo.com
CORS_ORIGINS=https://painel.exemplo.com
# Outros nomes do ápice (separados por vírgula): o domínio de marketing servindo
# a mesma página pública e o console, sem redirecionar. O `www.` de cada um vem junto.
# Também vale sem TENANT_BASE_DOMAIN (endereço único): aí configure PUBLIC_BASE_URL.
# PLATFORM_EXTRA_HOSTS=exemplo.com

# --- Segredos (openssl rand -hex 48 para cada um) --------------------------
JWT_SECRET=
PORTAL_JWT_SECRET=
# Cifra o que um operador pode ler de volta (credencial NBI, senha de portal).
# Separado do JWT_SECRET para poder trocar sessão sem perder esses dados.
SECRET_BOX_KEY=
# Quem coleta as métricas em /api/platform/metrics. Vazio = só o console.
METRICS_TOKEN=

# --- Sessões ---------------------------------------------------------------
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# --- E-mail (opcional) ------------------------------------------------------
# Sem estas duas não há envio, e o link do convite continua saindo na resposta
# da API para quem convidou entregar como quiser.
SMTP_URL=
MAIL_FROM=TR69 Controle <nao-responda@exemplo.com>

# --- Log -------------------------------------------------------------------
# text (uma linha legível) ou json (um objeto por linha, para o coletor).
LOG_FORMAT=json
# debug, info, warn ou error.
LOG_LEVEL=info

# --- Retenção --------------------------------------------------------------
# Por quantos dias guardar os pedidos de contato da vitrine (`leads`).
# VAZIO OU 0 É PARA SEMPRE, e é o padrão: um update não pode começar a apagar
# linha que ninguém mandou apagar. Com prazo, a poda diária leva os pedidos mais
# velhos que ele — menos os marcados `won`, que são o único registro de como um
# provedor pagante chegou e nunca são podados. Limites de 30 a 3650 dias; o que
# não for inteiro simples é lido como 0, não como um prazo que ninguém escolheu.
LEAD_RETENTION_DAYS=
