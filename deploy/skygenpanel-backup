#!/usr/bin/env bash
#
# skygenpanel-backup — one consistent copy of everything this panel cannot be
# rebuilt without.
#
# Three things, and the third is the one people forget:
#
#   1. the database — Postgres, MySQL or SQLite, whichever this install uses;
#   2. the DATA_DIR tree — the WhatsApp attachments and db-config.json. Paths in
#      the database are relative to DATA_DIR on purpose, so a restore may move
#      the directory; what it may not do is leave the tree behind;
#   3. the fingerprint of the encryption keys. SECRET_BOX_KEY and JWT_SECRET are
#      what decrypt the portal passwords, the WiFi passwords, and every stored
#      token. Restore the database with the wrong ones and the panel boots,
#      answers 200, and every secret is silently gone — `decrypt` returns null
#      and the screen shows a password that "disappeared" instead of a key that
#      is missing. The .env itself is NOT copied by default (see below); its
#      fingerprint is, so the day of the restore ends in a comparison instead of
#      a guess.
#
set -euo pipefail

INSTALL_DIR="${SKYGP_DIR:-/opt/skygenpanel}"
# Overridable because the hosted edition keeps it somewhere else: the compose
# file reads deploy/saas.env, and the fingerprint has to be of the keys that
# process actually runs with.
ENV_FILE="${SKYGP_ENV_FILE:-${INSTALL_DIR}/backend/.env}"
DEST_ROOT="${SKYGP_BACKUP_DIR:-/var/backups/skygenpanel}"
KEEP_DAILY="${SKYGP_BACKUP_KEEP_DAILY:-30}"
KEEP_WEEKLY="${SKYGP_BACKUP_KEEP_WEEKLY:-52}"
INCLUDE_SECRETS="${SKYGP_BACKUP_INCLUDE_SECRETS:-0}"

log()  { printf '\033[1;34m[skygp-backup]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[skygp-backup]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[skygp-backup]\033[0m %s\n' "$*" >&2; exit 1; }

# The destination must not live inside what it copies. A backup under DATA_DIR
# grows on top of itself: every run copies yesterday's copy, and the disk fills
# at the square of the data. install.sh already refuses an overlap between
# INSTALL_DIR and DATA_DIR for the same reason.
validate_dest() {
  [[ "$DEST_ROOT" = /* ]] || die "Backup directory must be an absolute path: $DEST_ROOT"
  local resolved
  resolved="$(realpath -m -- "$DEST_ROOT")" || die "Unable to resolve backup directory: $DEST_ROOT"
  [ "$resolved" = "$DEST_ROOT" ] || die "Backup directory must be normalized and free of symlinks: $DEST_ROOT"
  [ ! -L "$DEST_ROOT" ] || die "Refusing symbolic-link backup directory: $DEST_ROOT"
  case "$DEST_ROOT" in
    "$INSTALL_DIR"|"$INSTALL_DIR"/*) die "Backup directory must be outside the install directory." ;;
  esac
  case "$DEST_ROOT" in
    "${SKYGP_DATA_DIR:-/nonexistent}"|"${SKYGP_DATA_DIR:-/nonexistent}"/*)
      die "Backup directory must be outside DATA_DIR ($SKYGP_DATA_DIR)." ;;
  esac
}

# The connection, read by the only thing that knows the precedence: the panel's
# own config module. `eval` of a command substitution, never of a file — and the
# script it runs quotes every value, including a password that may contain
# anything the operator typed.
read_target() {
  local saida
  saida="$(cd "$INSTALL_DIR/backend" && node scripts/backup-target.js)" \
    || die "Could not read the database target. Is the panel installed at $INSTALL_DIR?"
  eval "$saida"
  [ -n "${SKYGP_CLIENT:-}" ] || die "backup-target.js named no database client."
}

# sha256 of a file, bare.
digest() { sha256sum -- "$1" | cut -d' ' -f1; }

# The fingerprint of one variable in the .env — never the value.
#
# Salted with the variable name so two different secrets that happen to be equal
# do not produce the same digest, and truncated because what is wanted is
# "did it change", not "what is it". A full digest of a short secret is a
# target for a dictionary; twelve hex characters are not.
env_fingerprint() {
  local nome="$1" valor
  valor="$(grep -E "^${nome}=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- || true)"
  if [ -z "$valor" ]; then
    printf 'absent'
    return
  fi
  printf '%s' "${nome}:${valor}" | sha256sum | cut -c1-12
}

dump_postgres() {
  local arquivo="$1"
  command -v pg_dump >/dev/null 2>&1 \
    || die "This install uses PostgreSQL and pg_dump is not on the machine. Install postgresql-client."
  local args=(--format=custom --no-owner --no-privileges
              --host="$SKYGP_HOST" --port="$SKYGP_PORT" --username="$SKYGP_USER"
              --dbname="$SKYGP_DATABASE" --file="$arquivo")
  [ -z "${SKYGP_SCHEMA:-}" ] || args+=(--schema="$SKYGP_SCHEMA")
  # The password by environment and not by argv: a password on a command line is
  # readable in `ps` by every user on the machine.
  PGPASSWORD="$SKYGP_PASSWORD" \
  PGSSLMODE="$([ "$SKYGP_SSL" = 1 ] && { [ "$SKYGP_SSL_VERIFY" = 1 ] && echo verify-full || echo require; } || echo disable)" \
    pg_dump "${args[@]}"
}

dump_mysql() {
  local arquivo="$1"
  command -v mysqldump >/dev/null 2>&1 \
    || die "This install uses MySQL/MariaDB and mysqldump is not on the machine. Install mariadb-client or mysql-client."
  # Same reason as above, by the route mysqldump offers: a 0600 file it reads
  # and deletes, rather than -p on the command line.
  local cred
  cred="$(mktemp)"
  chmod 600 -- "$cred"
  trap 'rm -f -- "${cred:-}"' RETURN
  {
    printf '[client]\n'
    printf 'password=%s\n' "$SKYGP_PASSWORD"
  } > "$cred"
  mysqldump "--defaults-extra-file=$cred" \
    --host="$SKYGP_HOST" --port="$SKYGP_PORT" --user="$SKYGP_USER" \
    --single-transaction --routines --events --default-character-set=utf8mb4 \
    "$SKYGP_DATABASE" > "$arquivo"
}

dump_sqlite() {
  local arquivo="$1"
  ( cd "$INSTALL_DIR/backend" && node scripts/backup-sqlite.js "$arquivo" ) >/dev/null
}

cmd_run() {
  read_target
  validate_dest
  # No blanket root check. Root is how the timer runs it, but what the run
  # actually needs is two permissions, and naming them says which one is
  # missing — "this command needs root" is what an operator reads three times
  # before finding out the destination was the problem all along.
  mkdir -p -- "$DEST_ROOT" 2>/dev/null \
    || die "Cannot create the backup directory $DEST_ROOT (run as root, or set SKYGP_BACKUP_DIR)."
  [ -w "$DEST_ROOT" ] || die "No permission to write into $DEST_ROOT (run as root?)."
  # The env file is not required — a backup of the data without the key
  # fingerprint is still worth having. It is required to be SILENT about it
  # never, because the fingerprint is the whole reason a restore does not end in
  # a guess.
  [ -r "$ENV_FILE" ] \
    || warn "Cannot read $ENV_FILE: this backup records no key fingerprint, so nothing will tell you on restore day whether the keys still match."

  local carimbo destino
  carimbo="$(date -u +%Y-%m-%dT%H%M%SZ)"
  destino="$DEST_ROOT/$carimbo"
  # 077 from here down: the dump carries every subscriber's personal data and
  # db-config.json carries the database password.
  umask 077
  mkdir -p -- "$destino"
  # A run that dies halfway leaves a timestamped directory behind, and an empty
  # directory with today's name is worse than no directory at all: `verify`
  # would skip it for having no manifest, but `prune` counts it as one of the
  # thirty kept — so thirty failures in a row would quietly push out the last
  # good backup. The directory only survives a run that reaches the end.
  #
  # A global and not `$destino`: the trap body is evaluated when the shell
  # exits, and by then a `local destino` inside whichever dump function died is
  # the one in scope — empty, so `rm -rf ''` removed nothing and the empty
  # directory stayed. Found by running the failure path and looking.
  PARCIAL="$destino"
  trap 'rm -rf -- "${PARCIAL:-}"' EXIT

  local arquivo_banco
  case "$SKYGP_CLIENT" in
    pg)            arquivo_banco="$destino/database.dump"; dump_postgres "$arquivo_banco" ;;
    mysql2)        arquivo_banco="$destino/database.sql";  dump_mysql    "$arquivo_banco" ;;
    better-sqlite3) arquivo_banco="$destino/panel.sqlite"; dump_sqlite   "$arquivo_banco" ;;
    *)             die "Unknown database client: $SKYGP_CLIENT" ;;
  esac
  # A belt, and only a belt: the real check is per-dialect and lives where it
  # can be exact. `backup-sqlite.js` refuses a copy with no migration ledger,
  # which is the case that actually happens — `integrity_check` says `ok` for an
  # empty database, so a zero-byte panel.sqlite copies to 4 KB of header and
  # exits 0. `pg_dump` and `mysqldump` die non-zero on their own failures, and
  # `set -e` catches those above. What is left for this line is the tool that
  # someday exits 0 having written nothing.
  [ -s "$arquivo_banco" ] || die "The database dump came out empty: $arquivo_banco"

  # The attachments. Their paths in the database are relative to DATA_DIR, so the
  # tree restores anywhere — but a database without it is an inbox whose
  # attachments no longer open.
  local arquivo_midia=""
  if [ -d "${SKYGP_MEDIA_DIR:-}" ]; then
    arquivo_midia="$destino/wa-media.tar.gz"
    tar -czf "$arquivo_midia" -C "$SKYGP_DATA_DIR" wa-media
  fi

  local arquivo_config=""
  if [ -f "$SKYGP_DATA_DIR/db-config.json" ]; then
    arquivo_config="$destino/db-config.json"
    install -m 0600 "$SKYGP_DATA_DIR/db-config.json" "$arquivo_config"
  fi

  # The .env, only when asked for, and never silently. Default off because this
  # directory would then hold the master key AND the database password AND the
  # data, which trades "I lost the data" for "I published the whole panel".
  local arquivo_env=""
  if [ "$INCLUDE_SECRETS" = 1 ]; then
    [ -f "$ENV_FILE" ] || die "SKYGP_BACKUP_INCLUDE_SECRETS=1 but there is no $ENV_FILE"
    mkdir -p -- "$destino/secrets"
    arquivo_env="$destino/secrets/env"
    install -m 0600 "$ENV_FILE" "$arquivo_env"
    warn "This backup contains $ENV_FILE in the clear. Encrypt it before it leaves this machine."
  fi

  local versao revisao topo_do_ledger
  versao="$(node -e "process.stdout.write(require('$INSTALL_DIR/package.json').version)" 2>/dev/null || echo unknown)"
  revisao="$(git -C "$INSTALL_DIR" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
  # Which migration this dump was taken at. On the day of the restore this is
  # the line that says whether the dump is older than the binary about to open
  # it — which is the normal upgrade path, but it is better to know that is what
  # happened than to wonder.
  topo_do_ledger="$(
    cd "$INSTALL_DIR/backend" && node -e "
      import('./src/config/database.js').then(async ({ getDb, closePool }) => {
        try {
          const linha = await getDb()('schema_migrations').orderBy('id', 'desc').first();
          process.stdout.write(linha?.id ?? 'none');
        } finally { await closePool(); }
      }).catch(() => process.stdout.write('unknown'))
    " 2>/dev/null || echo unknown
  )"

  {
    printf '{\n'
    printf '  "takenAt": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "client": "%s",\n' "$SKYGP_CLIENT"
    printf '  "panelVersion": "%s",\n' "$versao"
    printf '  "revision": "%s",\n' "$revisao"
    printf '  "schemaMigration": "%s",\n' "$topo_do_ledger"
    printf '  "includesEnv": %s,\n' "$([ "$INCLUDE_SECRETS" = 1 ] && echo true || echo false)"
    printf '  "secretFingerprints": { "SECRET_BOX_KEY": "%s", "JWT_SECRET": "%s" },\n' \
      "$(env_fingerprint SECRET_BOX_KEY)" "$(env_fingerprint JWT_SECRET)"
    printf '  "files": {\n'
    printf '    "%s": { "bytes": %s, "sha256": "%s" }' \
      "$(basename "$arquivo_banco")" "$(stat -c%s "$arquivo_banco")" "$(digest "$arquivo_banco")"
    if [ -n "$arquivo_midia" ]; then
      printf ',\n    "wa-media.tar.gz": { "bytes": %s, "sha256": "%s" }' \
        "$(stat -c%s "$arquivo_midia")" "$(digest "$arquivo_midia")"
    fi
    if [ -n "$arquivo_config" ]; then
      printf ',\n    "db-config.json": { "bytes": %s, "sha256": "%s" }' \
        "$(stat -c%s "$arquivo_config")" "$(digest "$arquivo_config")"
    fi
    printf '\n  }\n}\n'
  } > "$destino/manifest.json"

  PARCIAL=""
  trap - EXIT
  prune
  log "backup ok $destino $(du -sb "$destino" | cut -f1) bytes"
}

# Keep the most recent N, plus the Sunday one of each of the last M weeks.
#
# Sundays promoted rather than a second schedule: one run a day, and which ones
# survive is a reading of the names, so a machine that was off for a week does
# not lose its weekly line too.
prune() {
  local -a todos
  mapfile -t todos < <(find "$DEST_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r)
  local mantidos=0 semanais=0
  for nome in "${todos[@]}"; do
    if [ "$mantidos" -lt "$KEEP_DAILY" ]; then
      mantidos=$((mantidos + 1))
      continue
    fi
    # 0 is Sunday for `date -d`.
    if [ "$semanais" -lt "$KEEP_WEEKLY" ] && [ "$(date -u -d "${nome%%T*}" +%w 2>/dev/null || echo x)" = 0 ]; then
      semanais=$((semanais + 1))
      continue
    fi
    rm -rf -- "$DEST_ROOT/$nome"
  done
}

# The cheap check, for a monitoring probe: how old is the newest backup, and do
# the keys that encrypted it still match the ones on this machine.
cmd_verify() {
  validate_dest
  [ -r "$ENV_FILE" ] || die "Cannot read $ENV_FILE, so there is nothing to compare the fingerprints against."

  local ultimo
  ultimo="$(find "$DEST_ROOT" -mindepth 2 -maxdepth 2 -name manifest.json -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | head -1 | cut -d' ' -f2-)"
  [ -n "$ultimo" ] || die "No backup found under $DEST_ROOT"

  local idade_h
  idade_h=$(( ( $(date +%s) - $(stat -c%Y "$ultimo") ) / 3600 ))
  log "newest backup: $(dirname "$ultimo") (${idade_h}h old)"

  local gravado_box gravado_jwt agora_box agora_jwt
  gravado_box="$(node -e "process.stdout.write(require('$ultimo').secretFingerprints.SECRET_BOX_KEY)")"
  gravado_jwt="$(node -e "process.stdout.write(require('$ultimo').secretFingerprints.JWT_SECRET)")"
  agora_box="$(env_fingerprint SECRET_BOX_KEY)"
  agora_jwt="$(env_fingerprint JWT_SECRET)"

  local divergiu=0
  [ "$gravado_box" = "$agora_box" ] || { warn "SECRET_BOX_KEY changed since that backup was taken."; divergiu=1; }
  [ "$gravado_jwt" = "$agora_jwt" ] || { warn "JWT_SECRET changed since that backup was taken."; divergiu=1; }
  if [ "$divergiu" = 1 ]; then
    # Not a failure by itself — a rotation is a legitimate thing to do. It IS a
    # failure to discover it on the day of the restore, which is why it is said
    # here, loudly, while there is still time to file the old key with the dump.
    die "Restoring that backup needs the PREVIOUS key, which is not the one in $ENV_FILE."
  fi
  log "the encryption keys still match the ones that backup was taken with"
}

usage() {
  cat <<EOF
skygenpanel-backup — copy the database, the attachments and the key fingerprint

Usage: skygenpanel-backup [run|verify]

  run       Take a backup now (default). Runs from the systemd timer.
  verify    Report the age of the newest backup and whether the keys still match.

Environment:
  SKYGP_BACKUP_DIR              destination (default /var/backups/skygenpanel)
  SKYGP_BACKUP_KEEP_DAILY       daily copies kept (default 30)
  SKYGP_BACKUP_KEEP_WEEKLY      Sunday copies kept beyond those (default 52)
  SKYGP_BACKUP_INCLUDE_SECRETS  1 puts the .env in the backup, in the clear
EOF
}

case "${1:-run}" in
  run)             cmd_run ;;
  verify)          cmd_verify ;;
  help|-h|--help)  usage ;;
  *)               warn "Unknown command: $1"; usage; exit 1 ;;
esac
